leiosNotifyMessage
     = msgLeiosNotificationRequestNext
     / msgLeiosBlockAnnouncement
     / msgLeiosBlockOffer
     / msgLeiosBlockTxsOffer
     / msgLeiosVotes
     / msgClientDone

msgLeiosNotificationRequestNext = [0]
msgLeiosBlockAnnouncement       = [1, announcement_header]
msgLeiosBlockOffer              = [2, point]
msgLeiosBlockTxsOffer           = [3, point]
msgLeiosVotes                   = [4, [1* vote]]
msgClientDone                   = [5]

announcement_header = any ; TODO
point = (slot, eb_hash)
slot = base.slotno
eb_hash = base.hash

vote =
  [ slot
  , eb_hash
  , voter_id              : base.word16
  , vote_signature        : leios_bls_signature
  ]

; FIXME: non-mocked signatures
;leios_bls_signature = bytes .size 48
leios_bls_signature = bool

;# import base as base
