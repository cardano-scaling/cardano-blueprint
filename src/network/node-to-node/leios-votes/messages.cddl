leiosVotesMessage
     = msgRequestNextVote
     / msgLeiosVote
     / msgClientDone

msgRequestNextVote = [1, 0]
msgLeiosVote = [2, vote]
msgClientDone = [3]

vote =
  [ election_id
  , leios.eb_hash
  , voter_id
  , vote_signature : leios_bls_signature
  ]

election_id = base.slotNo
voter_id = base.word16
leios_bls_signature = bytes .size 48

;# import base as base
;# import leios as leios
